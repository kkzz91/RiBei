<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标（Android 8+）：背景 + 前景两层，由启动器裁形状（圆/方圆角/方…）。
  前景用 mipmap/ic_launcher_foreground.png —— 图形已经缩进 108dp 画布中间的
  安全圆里，所以任何遮罩都不会切到它。
  旧系统（Android 7）读不到这个文件，会回退到 mipmap/ic_launcher.png。
  注意：这两个都不是通知图标，通知图标是 drawable/ic_notification.xml，别混。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
